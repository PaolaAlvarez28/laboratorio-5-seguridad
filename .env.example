# Copie este archivo como .env y pegue su DSN de Sentry (boton "Copy DSN").
# .env NO se sube a GitHub.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# true solo mientras prueba el error controlado; despues borrelo
SENTRY_DEBUG_ROUTE=false

# --- Grafana Cloud (OpenTelemetry) - SOLO en local, nunca en Render ---
# Grafana Cloud > su stack > OpenTelemetry > Configure: copie el endpoint y el token.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=una-chat-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# true habilita el fallo controlado: GET /api/fallo y el mensaje "/fallo" en el chat
CHAT_FALLO_CONTROLADO=true

# --- Auth0 + Supabase Vault (Laboratorio Client Secret) ---
# Si AUTH0_DOMAIN y AUTH0_CLIENT_ID quedan vacios, el chat queda abierto (pruebas).
# Dominio sin https:// (ejemplo: dev-xxxx.us.auth0.com)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# URI de Postgres del rol una_chat_backend. TLS obligatorio (sslmode=verify-full).
# Host directo (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler (IPv4): postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# No defina AUTH0_CLIENT_SECRET. El servidor lee una_chat_auth0_client_secret
# desde Supabase Vault al arrancar.
